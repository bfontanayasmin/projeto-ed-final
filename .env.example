# Copie para .env e troque as senhas: cp .env.example .env

# PostgreSQL
POSTGRES_DB=acidentes_origem
POSTGRES_USER=ed_user
POSTGRES_PASSWORD=troque_esta_senha
# Porta no host (5090 para não conflitar com um PostgreSQL local na 5432)
POSTGRES_HOST_PORT=5090

# MinIO (a senha precisa ter pelo menos 8 caracteres)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque_esta_senha
